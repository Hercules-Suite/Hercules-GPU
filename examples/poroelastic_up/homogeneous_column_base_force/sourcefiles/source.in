# Distributed compliant-base force source for a 1 m x 1 m column.

source_is_filtered        = 0
threshold_frequency       = 25.0
number_of_poles           = 4

type_of_source            = base_force
source_function_type      = discrete

# Explicit base impedance for the Lysmer-style force conversion.
# For this homogeneous first case, these match the column material.
base_force_rho_kgm3       = 2000.0
base_force_vs_mps         = 200.0

# x = north, y = east, z = down. This default is a horizontal shear input.
base_force_direction_x    = 1.0
base_force_direction_y    = 0.0
base_force_direction_z    = 0.0

# 1.0 = incident/within velocity; 2.0 = outcrop velocity.
base_force_scale          = 1.0
