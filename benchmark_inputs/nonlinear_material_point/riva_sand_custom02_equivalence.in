# RIVA-Sand intermediate-bias research host/CUDA full-state regression.
material_model = RIVASandCustom02
material_point_delta_time_sec = 1.0e-3
material_point_steps = 18
no_substeps = 4
error_tolerance = 1.0e-1
backbone_errTol = 1.0e-5
tension_cutoff = no
material_point_compare_rtol = 1.0e-8
material_point_compare_atol = 1.0e-10
material_point_output_prefix = riva_sand_custom02_equivalence

# Reference-row equivalence to RIVASand02, not a new calibration.
# Dr G0 M kd h m zeta e_max e_min Q R n_G
material_point_constants =
  0.66296296296296309 483.48301127222084 1.25 1.125 122.44207260468994 0.945 0.025 0.78 0.51 10.0 1.5 0.65

# Equilibrated K0 effective stress with intermediate static shear bias,
# tension-positive, in Pa. The p'=26.267 kPa and tau=10 kPa state is adapted
# from the frozen PRJ-3484 intermediate-bias oracle family. The common seeded
# parser requires all five arrays; the final three are placeholders because
# the research model initializes its own 138-value constitutive history.
material_point_initial_strain =
  0 0 0 0 0 0
material_point_initial_stress =
  -1.94e4 -1.94e4 -4.0e4 1.0e4 0 0
material_point_initial_alpha =
  0 0 0 0 0 0
material_point_initial_alpha_in =
  0 0 0 0 0 0
material_point_initial_fabric =
  0 0 0 0 0 0

# Independently exercise the sealed uniform-element BrickUP pressure replay.
# The research kernel owns only effective skeleton stress; BrickUP applies the
# fluid mass balance and total-stress/Biot split once.
material_point_brickup = yes
material_point_brickup_porosity = 0.40
material_point_brickup_fluid_bulk_modulus_pa = 2.2e9
material_point_brickup_biot_alpha = 1.0
material_point_initial_pore_pressure_pa = 0.0

# Physical tensor shear components. The final duplicate row is an explicit
# zero-increment contract check over all 138 state values and both selectors.
material_point_strain_history =
   0.0e+0  0.0e+0  0.0e+0  0.0e+0 0 0
  -1.0e-5 -1.0e-5 -1.0e-5  2.5e-4 0 0
  -2.0e-5 -2.0e-5 -2.0e-5  5.0e-4 0 0
  -3.0e-5 -3.0e-5 -3.0e-5  7.5e-4 0 0
  -4.0e-5 -4.0e-5 -4.0e-5  1.0e-3 0 0
  -3.5e-5 -3.5e-5 -3.5e-5  5.0e-4 0 0
  -3.0e-5 -3.0e-5 -3.0e-5  0.0e+0 0 0
  -2.5e-5 -2.5e-5 -2.5e-5 -5.0e-4 0 0
  -2.0e-5 -2.0e-5 -2.0e-5 -1.0e-3 0 0
  -2.5e-5 -2.5e-5 -2.5e-5 -5.0e-4 0 0
  -3.0e-5 -3.0e-5 -3.0e-5  0.0e+0 0 0
  -3.5e-5 -3.5e-5 -3.5e-5  5.0e-4 0 0
  -4.0e-5 -4.0e-5 -4.0e-5  1.0e-3 0 0
  -3.5e-5 -3.5e-5 -3.5e-5  5.0e-4 0 0
  -3.0e-5 -3.0e-5 -3.0e-5  0.0e+0 0 0
  -2.5e-5 -2.5e-5 -2.5e-5 -5.0e-4 0 0
  -2.0e-5 -2.0e-5 -2.0e-5 -1.0e-3 0 0
  -2.0e-5 -2.0e-5 -2.0e-5 -1.0e-3 0 0
