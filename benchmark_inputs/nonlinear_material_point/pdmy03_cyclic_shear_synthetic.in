9.0e7 2.2e8 32.0 0.10 1.01e5 0.50 26.0 0
0.067 0.50 0.23 1.0 0.0 0.06 3.0 0.27
20 1.0e4 0.01 1.01e5 1.73e3

# Seed the beginning of the plastic stage after isotropic consolidation.
material_point_initial_strain =
-1.5151515151515152e-4 -1.5151515151515152e-4 -1.5151515151515152e-4 0.0 0.0 0.0
material_point_initial_stress =
-1.0e5 -1.0e5 -1.0e5 0.0 0.0 0.0
