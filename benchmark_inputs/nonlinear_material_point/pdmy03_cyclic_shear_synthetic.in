# Synthetic PressureDependMultiYield03 host/CUDA nested-surface regression.
# These values exercise the algorithm; they are not a soil calibration.
material_model = PressureDependMultiYield03
material_point_delta_time_sec = 1.0
material_point_steps = 18
no_substeps = 100
error_tolerance = 1.0e-1
backbone_errTol = 1.0e-4
tension_cutoff = no
material_point_compare_rtol = 1.0e-9
material_point_compare_atol = 1.0e-9
material_point_output_prefix = pdmy03_cyclic_shear_synthetic

# Gref Kref phi peak_gamma ref_pressure pressure_exponent PT_angle mType
# ca cb cc cd ce da db dc surfaces liquefaction1 liquefaction2 Patm cohesion
