# Case 2 - SH site-response transfer function (POROELASTIC run).
#
# Soft saturated soil (0-20 m) over stiffer bedrock; a horizontal compliant-base
# force injects a vertically-propagating shear wave. The surface/within spectral
# ratio is compared to the analytical 1D SH transfer function. Shear is
# fluid-INDEPENDENT, so this run must match the elastic twin (../elastic).
#
# Layer (soft): Vs1=150, rho1=1900, H=20 m -> f0 = Vs1/(4H) = 1.875 Hz,
# impedance ratio alpha_z = (rho1*Vs1)/(rho2*Vs2) = 0.288, peak amp ~ 1/alpha_z ~ 3.5.
#
#   mpirun -np <N> <path-to-psolve> parameters.in

region_origin_latitude_deg  = 0.0
region_origin_longitude_deg = 0.0
region_depth_shallow_m      = 0.0
region_length_east_m        = 1.0
region_length_north_m       = 1.0
region_depth_deep_m         = 64.0
region_azimuth_leftface_deg = 0.0

type_of_damping             = none
abc_type                    = dashpot
stiffness_calculation_method = effective

source_directory            = ../sourcefiles
source_directory_output     = output/srctmp

monitor_file = output/monitor.txt

simulation_wave_max_freq_hz    = 15.0
simulation_start_time_sec      = 0.0
simulation_end_time_sec        = 4.00
simulation_delta_time_sec      = 0.0001
simulation_node_per_wavelength = 8
simulation_shear_velocity_min  = 150.0
simulation_output_rate         = 10000000

the_threshold_damping          = 0.05
the_threshold_Vp_over_Vs       = 3.0
do_damping_statistics          = 0

output_mesh                    = 1
mesh_only_mode                 = 0
mesh_input_mode                = 0
mesh_etree_output_file         = output/mesh.e

use_checkpoint                 = 0
checkpointing_rate             = 0
checkpoint_path                = output/checkpoints

# 2-layer profile (dry/drained skeleton): z_top Vp Vs rho Qp Qs
cvmdb_input_file               = profile
number_profile_layers          = 2
profile_layers =
 0.0  300.0 150.0 1900.0 1000000.0 1000000.0
 20.0 900.0 450.0 2200.0 1000000.0 1000000.0

output_displacement            = 0
output_velocity                = 0

number_output_planes           = 0
output_planes_print_rate       = 1
output_planes_directory        = output/planes

# Surface (z=0) and within-bedrock (z=25, 5 m below the interface) receivers.
number_output_stations         = 2
output_stations_print_rate     = 5
output_stations_directory      = output/stations
print_station_velocities       = yes
print_station_accelerations    = no
print_station_pressures        = yes

output_stations =
 0.000004491576 0.000004491576  0.0
 0.000004491576 0.000004491576 25.0

include_buildings              = no
implement_drm                  = no
include_topography             = no
include_acoustic               = no
include_nonlinear_analysis     = no
include_incident_planewaves    = no
include_hmg_halfspace          = no
Istanbul_velocity_model        = no
basin_velocity_model           = no
3D_velocity_model              = no
mesh_coordinates_for_matlab    = no

# Undrained poroelastic column (perm=0). Shear response is fluid-independent.
include_poroelastic            = yes
poroelastic_formulation        = brick_up
poroelastic_depth_max_m        = 64.0
surface_groundwatertable       = no
poroelastic_surface_pressure_bc = undrained
poroelastic_undrained_fast_path = yes
poroelastic_surface_pressure_penalty_factor = 1.0
poroelastic_elastic_interface  = no_flow
poroelastic_porosity           = 0.4
poroelastic_biot_alpha         = 1.0
poroelastic_fluid_bulk_modulus_pa = 2.2e9
poroelastic_fluid_density_kgm3 = 1000.0
poroelastic_fluid_viscosity_pa_s = 1.0e-3
poroelastic_permeability_x_m2  = 0.0
poroelastic_permeability_y_m2  = 0.0
poroelastic_permeability_z_m2  = 0.0
